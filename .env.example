WEB_DOMAIN=spadeai.labmirai.org
API_DOMAIN=api.spadeai.labmirai.org
WEB_HOST=0.0.0.0
WEB_BIND=127.0.0.1
WEB_PORT=3000
API_HOST=0.0.0.0
API_BIND=127.0.0.1
API_PORT=8000

WEB_SSL_CERTIFICATE=/etc/letsencrypt/live/spadeai.labmirai.org/fullchain.pem
WEB_SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/spadeai.labmirai.org/privkey.pem
API_SSL_CERTIFICATE=/etc/letsencrypt/live/api.spadeai.labmirai.org/fullchain.pem
API_SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/api.spadeai.labmirai.org/privkey.pem

POSTGRES_USER=spade
POSTGRES_PASSWORD=replace-with-a-long-password
POSTGRES_DB=spade
DATABASE_URL=postgresql+asyncpg://spade:replace-with-a-long-password@db:5432/spade
DATABASE_SSL=false

SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=https://spadeai.labmirai.org
